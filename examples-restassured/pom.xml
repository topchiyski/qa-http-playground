<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.qaplayground</groupId>
        <artifactId>qa-http-playground-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>examples-restassured</artifactId>
    <name>examples-restassured</name>
    <description>
        REST Assured course: lessons, exercises and solutions. See docs/learning-paths/rest-assured/.
        Run against an already running server with -Dplayground.baseUri=http://localhost:8080;
        without it, the tests start the server in-process on a random port.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lesson 11: JSON Schema validation -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Only used to boot the server in-process when no baseUri is given. -->
        <dependency>
            <groupId>io.qaplayground</groupId>
            <artifactId>playground-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Lessons (*Test), solutions and the project (*Solution) run in every build; exercise
                         stubs (*Exercise) are listed as skipped until the learner removes @Disabled. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Solution.java</include>
                        <include>**/*Exercise.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
